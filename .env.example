# Louisa Shopping — variables d'environnement requises
# Noms uniquement — voir devops-reference.md pour le détail par service.
# À déclarer : Netlify (Site settings > Environment variables) + GitHub
# Actions Secrets (mêmes noms, pour le job de build en CI).
# Copier en .env.local pour le dev (jamais commité).



# --- Supabase (Postgres + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connexion Postgres LECTURE PUBLIQUE (RLS active) — rôle NON privilégié,
# jamais `postgres`/owner. Utilisée par dbAnon.
# NB Supabase : `anon` est NOLOGIN — il faut un vrai rôle LOGIN qui hérite de
# `anon` (ex. CREATE ROLE app_anon LOGIN ... ; GRANT anon TO app_anon;).
DATABASE_URL_ANON=
# Connexion Postgres ADMIN (bypass RLS) — utilisée par dbAdmin, Better Auth, seed.
# Idem : `service_role` est NOLOGIN, prévoir un rôle LOGIN dédié.
DATABASE_URL_ADMIN=
# Connexion Postgres DDL pour les migrations + policies (drizzle-kit migrate,
# scripts/apply-policies.mjs). Rôle `postgres` (LOGIN + droits DDL).
DATABASE_URL_MIGRATE=

# --- Better Auth ---
BETTER_AUTH_SECRET=
# URL publique de l'app (ex. https://louisa-shopping.netlify.app en prod,
# http://localhost:3000 en dev)
BETTER_AUTH_URL=

# --- App ---
# Base URL absolue pour les liens dans les messages WhatsApp de commande
NEXT_PUBLIC_BASE_URL=

# --- Redis Upstash (sessions panier uniquement) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
# Jeton perso Sentry (upload des source maps en CI). NE JAMAIS committer une
# vraie valeur ici — la mettre dans .env.local / les secrets CI uniquement.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- WhatsApp (lien direct wa.me — pas d'API) ---
# Numéro/lien porté par WhatsappConfig (DB, singleton), pas une variable
# d'environnement — aucune clé à déclarer ici.
