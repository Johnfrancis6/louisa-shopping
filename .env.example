# Louisa Shopping — variables d'environnement requises
# Noms uniquement — voir devops-reference.md pour le détail par service.
# À déclarer : Netlify (Site settings > Environment variables) + GitHub
# Actions Secrets (mêmes noms, pour le job de build en CI).
# Copier en .env.local pour le dev (jamais commité).



# --- Supabase (Postgres + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#
# Trois connexions Postgres, trois rôles distincts. `anon` / `service_role` de
# Supabase sont NOLOGIN — impossible de s'y connecter directement. On crée donc
# deux rôles applicatifs LOGIN (une seule fois, via la connexion `postgres`) :
#   create role app_anon    login password '<pw>' in role anon;
#   create role app_service login password '<pw>' bypassrls in role service_role;
# Les GRANT niveau table pour ces rôles sont posés par supabase/policies.sql
# (`npm run db:deploy`). Format URL pooler : <role>.<project_ref>@...pooler...:5432
#
# dbAnon — LECTURE PUBLIQUE, RLS active (app_anon, PAS de BYPASSRLS).
DATABASE_URL_ANON=
# dbAdmin — accès complet + Better Auth (app_service, BYPASSRLS).
DATABASE_URL_ADMIN=
# DDL : migrations + policies + seed + promote-admin (rôle `postgres`).
# drizzle.config.ts, scripts/apply-policies.mjs, src/lib/db/seed.ts,
# scripts/promote-admin.mjs lisent cette variable (fallback DATABASE_URL_ADMIN).
DATABASE_URL_MIGRATE=

# --- Better Auth ---
BETTER_AUTH_SECRET=
# URL publique de l'app (ex. https://louisa-shopping.netlify.app en prod,
# http://localhost:3000 en dev)
BETTER_AUTH_URL=

# --- App ---
# Base URL absolue pour les liens dans les messages WhatsApp de commande
NEXT_PUBLIC_BASE_URL=

# --- Redis Upstash (sessions panier uniquement) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
# Jeton perso Sentry (upload des source maps en CI). NE JAMAIS committer une
# vraie valeur ici — la mettre dans .env.local / les secrets CI uniquement.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- WhatsApp (lien direct wa.me — pas d'API) ---
# Numéro/lien porté par WhatsappConfig (DB, singleton), pas une variable
# d'environnement — aucune clé à déclarer ici.
